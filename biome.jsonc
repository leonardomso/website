{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "linter": {
    "rules": {
      // Inline handlers on small, static lists; memoizing them buys nothing.
      "performance": {
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        // text-wrap, ::marker and friends are progressive enhancements here.
        "useBaseline": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
