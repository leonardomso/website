---
import "@fontsource-variable/inter";
import "~/styles/globals.css";
import { CommandPalette } from "~/components/command-palette";
import { JsonLd, personSchema, websiteSchema } from "~/components/json-ld";
import { NAV_LINKS, SECONDARY_LINKS, SITE_URL } from "~/config/site";

interface Props {
  canonical?: string;
  description?: string;
  /** The home page hides the "Home" footer link. */
  home?: boolean;
  /** Keep the page out of search indexes (and skip canonical + Markdown twin). */
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  title?: string;
}

const DEFAULT_OG_IMAGE = `${SITE_URL}/opengraph-image`;

const {
  title = "Leonardo Maldonado",
  description = "Senior full-stack engineer in Valencia, Spain. Building SetLuca. Previously the only frontend engineer on Spaceship's domain search at Namecheap and creator of 33 JavaScript Concepts.",
  canonical = SITE_URL,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  home = false,
  noindex = false,
} = Astro.props;

// Every indexable page has a Markdown twin at the same path plus ".md".
const markdownPath =
  Astro.url.pathname === "/"
    ? "/index.md"
    : `${Astro.url.pathname.replace(/\.html$/u, "").replace(/\/$/u, "")}.md`;

const currentPath = Astro.url.pathname.replace(/\.html$/u, "");
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Leonardo Maldonado" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" type="text/markdown" href={`${SITE_URL}${markdownPath}`} />
      </>
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Leonardo Maldonado" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@leonardomso" />
    <meta name="twitter:site" content="@leonardomso" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <JsonLd data={personSchema} />
    <JsonLd data={websiteSchema} />
    <CommandPalette client:idle />

    <div class="page">
      <header class="site-header">
        <a href="/" class="site-name" aria-current={home ? "page" : undefined}>Leonardo Maldonado</a>
        <nav class="site-nav" aria-label="Primary">
          {NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
      </header>

      <main id="main" class="content">
        <slot />
      </main>

      <footer class="site-footer">
        <nav class="links" aria-label="More pages">
          {!home && <a href="/">Home</a>}
          {SECONDARY_LINKS.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
      </footer>
    </div>

    <script is:inline async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>
