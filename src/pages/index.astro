---
import { projects } from "~/config/projects";
import { SOCIAL_LINKS, WORK } from "~/config/site";
import BaseLayout from "~/layouts/base-layout.astro";
---

<BaseLayout
  home
  title="Leonardo Maldonado · Senior Full-Stack Engineer"
  description="Senior full-stack engineer in Valencia, Spain. Building SetLuca, a DM sales platform for creators and coaches. Previously the only frontend engineer on Spaceship's domain search at Namecheap. Creator of 33 JavaScript Concepts."
>
  <section class="hero" aria-label="About">
    <h1 class="display">I build products end to end in TypeScript. <span class="mute">Right now that’s <a href="https://setluca.com">SetLuca</a>, a DM sales platform for experts, creators and coaches.</span></h1>
    <p class="hero-sub mute text">Senior full-stack engineer in Valencia. Four and a half years as the only frontend engineer on Spaceship’s domain search at Namecheap. Author of <a href="https://github.com/leonardomso/33-js-concepts">33 JavaScript Concepts</a>.</p>
  </section>

  <section class="section" aria-labelledby="h-projects">
    <h2 id="h-projects">Projects</h2>
    <ul class="cards grid-2">
      {projects.map((project) => (
        <li>
          <a href={project.url}>
            <span class="title-lg">{project.title}<span aria-hidden="true" class="arrow">↗</span></span>
            <span class="mute">{project.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="h-work">
    <h2 id="h-work">Work</h2>
    <ul class="list">
      {WORK.map((job) => (
        <li>
          <span class="name">{job.company}</span>
          <span class="role">{job.role}</span>
          <span class="years">{job.years}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section grid-2">
    <div>
      <h2 id="h-writing">Writing</h2>
      <p class="text">Over 100 articles on React, TypeScript and frontend performance for <a href="https://blog.logrocket.com/author/leonardomaldonado/">LogRocket</a> and <a href="https://www.telerik.com/blogs/author/leonardo-maldonado">Progress</a>.</p>
    </div>
    <div>
      <h2 id="h-contact">Contact</h2>
      <p class="links">{SOCIAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(16px, 4vh, 40px);
    padding-bottom: clamp(56px, 10vh, 96px);
  }

  .hero-sub {
    max-width: 30rem;
    margin-top: 28px;
    text-wrap: pretty;
  }
</style>
