<BaseLayout
  title="Now · Leonardo Maldonado"
  description="What Leonardo Maldonado is working on right now."
  canonical={`${SITE_URL}/now`}
>
  <h1 class="page-title">Now</h1>
  <p class="mute text">What I’m focused on at the moment. This is a <a href="https://nownownow.com/about">now page</a>.</p>

  <section class="section" aria-labelledby="h-work">
    <h2 id="h-work">Work</h2>
    <div class="stack">
    <p class="text">I left <a href="https://www.namecheap.com">Namecheap</a> in June 2026 after four and a half years as the only frontend engineer on Spaceship’s domain search. Since July I’ve been building <a href="https://setluca.com">SetLuca</a>, a DM sales platform for experts, creators and coaches.</p>
    <p>I’m open to senior full-stack and freelance roles, remote or partly on-site in Europe.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="h-side">
    <h2 id="h-side">Side project</h2>
    <p class="text"><a href="https://strait.dev">Strait</a>, background jobs and workflows that run on Postgres, with no Redis or separate queue.</p>
  </section>

  <section class="section" aria-labelledby="h-open-source">
    <h2 id="h-open-source">Open source</h2>
    <p class="text">Maintaining <a href="https://github.com/leonardomso/33-js-concepts">33 JavaScript Concepts</a>, now at 66K stars and 40+ translations, and recently relaunched as a website.</p>
  </section>

  <section class="section" aria-labelledby="h-learning">
    <h2 id="h-learning">Learning</h2>
    <p>Patterns for AI agents, MCP servers, and Go for backend systems.</p>
  </section>

  <section class="section" aria-labelledby="h-life">
    <h2 id="h-life">Life</h2>
    <p>Living in Valencia and enjoying the Mediterranean pace.</p>
  </section>

  <p class="section mute">Updated November 2026</p>
</BaseLayout>
