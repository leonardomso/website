---
import { SITE_URL } from "~/config/site";
import BaseLayout from "~/layouts/base-layout.astro";

const categories = [
  {
    label: "Editor and terminal",
    items: [
      { name: "VS Code", description: "Editor" },
      { name: "Claude Code", description: "Coding agent" },
      { name: "iTerm2", description: "Terminal" },
      { name: "Geist Mono", description: "Editor and terminal font" },
    ],
  },
  {
    label: "Development",
    items: [
      { name: "TypeScript", description: "Most of what I write" },
      { name: "Go", description: "Backends and CLIs" },
      { name: "Rust", description: "Side projects" },
      { name: "React", description: "Interfaces" },
      { name: "Node.js and Bun", description: "Runtimes" },
      { name: "PostgreSQL", description: "Default database" },
      { name: "Redis", description: "Queues and real-time events" },
    ],
  },
  {
    label: "Apps",
    items: [
      { name: "Figma", description: "Design" },
      { name: "Notion", description: "Notes" },
    ],
  },
  {
    label: "Services",
    items: [
      { name: "GitHub", description: "Code" },
      { name: "Cloudflare", description: "Hosting and DNS" },
      { name: "Vercel", description: "Hosting" },
    ],
  },
  {
    label: "Hardware",
    items: [{ name: "MacBook Pro", description: "Apple Silicon" }],
  },
];
---

<BaseLayout
  title="Uses · Leonardo Maldonado"
  description="The editor, languages, apps and hardware Leonardo Maldonado uses every day."
  canonical={`${SITE_URL}/uses`}
>
  <h1 class="page-title">Uses</h1>
  <p class="mute">What I use every day to write and ship software.</p>

  {categories.map((category) => (
    <section class="section">
      <h2>{category.label}</h2>
      <ul class="list">
        {category.items.map((item) => (
          <li>
            <span class="name">{item.name}</span>
            <span class="role">{item.description}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
