---
import {
  breadcrumbSchema,
  JsonLd,
  softwareApplicationSchema,
} from "~/components/json-ld";
import { projects } from "~/config/projects";
import { SITE_URL } from "~/config/site";
import BaseLayout from "~/layouts/base-layout.astro";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", url: SITE_URL },
  { name: "Projects", url: `${SITE_URL}/projects` },
]);

const softwareSchemas = projects.map((project) =>
  softwareApplicationSchema({
    name: project.title,
    description: project.description,
    url: project.url,
    applicationCategory: project.category,
    programmingLanguage: project.languages,
    license: project.license,
  })
);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Projects by Leonardo Maldonado",
  url: `${SITE_URL}/projects`,
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: project.url,
    name: project.title,
  })),
};
---

<BaseLayout
  title="Projects · Leonardo Maldonado"
  description="What Leonardo Maldonado is building: SetLuca, a DM sales platform for creators and coaches, and Strait, background jobs and workflows on Postgres."
  canonical={`${SITE_URL}/projects`}
>
  <JsonLd data={breadcrumbs} />
  <JsonLd data={itemListSchema} />
  {softwareSchemas.map((schema) => <JsonLd data={schema} />)}

  <h1 class="page-title">Projects</h1>
  <p class="mute measure">What I’m building right now.</p>

  <ul class="entries section">
    {projects.map((project) => (
      <li>
        <div class="entry-head">
          <a class="title-lg" href={project.url}>{project.title}<span aria-hidden="true" class="arrow">↗</span></a>
          <span class="entry-meta">{project.tag}</span>
        </div>
        <p class="entry-body measure">{project.description}</p>
        <p class="entry-body">{project.tech.join(", ")}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
