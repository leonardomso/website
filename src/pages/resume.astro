---
import { EMAIL, SITE_URL } from "~/config/site";
import BaseLayout from "~/layouts/base-layout.astro";

const experiences: {
  period: string;
  role: string;
  company: string;
  companyUrl: string;
  bullets: string[];
}[] = [
  {
    period: "Nov 2021 – Jun 2026",
    role: "Senior Front End Engineer, Spaceship Domain Search",
    company: "Namecheap",
    companyUrl: "https://www.namecheap.com/",
    bullets: [
      "Only frontend engineer on Spaceship's domain search for four and a half years. Built the React and TypeScript frontend from scratch and owned architecture, code review and every release. The product sold more than 3 million domains.",
      "Built a real-time pricing engine over WebSockets that streams live prices for 500+ TLDs per search and keeps renders under 100ms on large result sets. Worked with the backend and platform teams on the streaming contract.",
      "Shipped Beast Mode, a bulk search for up to 100 domains at once with filters for price, category and TLD type. It became one of the most used features among power users.",
      "Added pricing in 30+ currencies with region-aware caching, which removed redundant API calls and cut price-fetch latency by about 60%.",
      "Reduced the bundle by 35% with code splitting and lazy rendering, so search-heavy pages load faster.",
      "Set the technical direction for the search frontend: component architecture, testing strategy and release process. Worked directly with product and design to scope and sequence the roadmap.",
    ],
  },
  {
    period: "May 2019 – Dec 2023",
    role: "Technical Author (contract)",
    company: "Progress",
    companyUrl: "https://www.telerik.com/blogs/author/leonardo-maldonado",
    bullets: [
      "Wrote about TypeScript and web engineering for the Progress blog: type safety with Zod, end-to-end typing with tRPC, pattern matching, browser storage with IndexedDB and React performance.",
    ],
  },
  {
    period: "Feb 2020 – Feb 2022",
    role: "Technical Author (freelance)",
    company: "LogRocket",
    companyUrl: "https://blog.logrocket.com/author/leonardomaldonado/",
    bullets: [
      "Wrote for the LogRocket engineering blog on React, hooks and state management (Valtio, MobX), frontend performance, lazy loading and Next.js rendering.",
      "Also covered JavaScript and CSS fundamentals such as type coercion, Big O and Flexbox versus Grid.",
    ],
  },
  {
    period: "Oct 2019 – Apr 2021",
    role: "Software Engineer",
    company: "Popstand",
    companyUrl: "https://popstand.com/",
    bullets: [
      "Built Taco Maps from scratch, a React Native food ordering app for taco restaurants in Los Angeles.",
      "Set up the whole stack: Redux, TypeScript, Firebase for real-time order updates, and end-to-end tests with Detox on iOS and Android.",
    ],
  },
  {
    period: "Jan 2019 – Jul 2019",
    role: "Software Engineer",
    company: "Foton",
    companyUrl: "https://foton.tech/",
    bullets: [
      "Built React and React Native apps for Brazilian banking clients, held to financial-grade security and reliability standards with end-to-end tests in Detox.",
    ],
  },
];

const projects: {
  name: string;
  url: string;
  meta: string;
  description: string;
}[] = [
  {
    name: "SetLuca",
    url: "https://setluca.com",
    meta: "Jul 2026 – now",
    description:
      "DM sales platform for experts, creators and coaches. Reads incoming DMs on Instagram, Messenger and Telegram, scores each lead, replies in the creator's own voice and books the call. TypeScript end to end: Hono on Cloudflare Workers, Inngest, TanStack Start, PostgreSQL and Drizzle.",
  },
  {
    name: "Strait",
    url: "https://strait.dev",
    meta: "Jan 2026 – now",
    description:
      "Background jobs and multi-step workflows on the Postgres database you already have, with no Redis or separate queue. Durable queues with retries and backoff, workflows that pause for manual approval, and a live dashboard. A single self-hostable Go binary under Apache-2.0, with SDKs for TypeScript, Python, Go, Ruby and Rust, plus MCP servers and a CLI.",
  },
];

const skills: { category: string; items: string }[] = [
  {
    category: "Languages",
    items: "TypeScript, JavaScript, Go, Rust, HTML, CSS",
  },
  {
    category: "Frontend",
    items:
      "React, Next.js, React Native, TanStack Start, TanStack Query, Vite, Tailwind CSS, Redux, Zustand",
  },
  {
    category: "Backend",
    items:
      "Node.js, Bun, Hono, Elysia, Inngest, GraphQL, REST, WebSocket, PostgreSQL, MySQL, Redis, MongoDB, Drizzle",
  },
  {
    category: "AI",
    items: "Vercel AI SDK, Anthropic API, OpenAI API, MCP, agents",
  },
  {
    category: "Infrastructure",
    items: "Cloudflare Workers, Vercel, Fly.io, Docker, GitHub Actions",
  },
  { category: "Testing", items: "Vitest, Jest, Playwright, Detox" },
  {
    category: "Spoken",
    items: "Portuguese (native), English (professional), Spanish (limited)",
  },
];

const education = [
  {
    school: "Universidade de Franca",
    degree: "BSc Computer Science",
    period: "2016 – 2020",
  },
  {
    school: "Centro Universitário Senac",
    degree: "Computer Engineering Technician",
    period: "2013 – 2014",
  },
];
---

<BaseLayout
  title="Resume · Leonardo Maldonado"
  description="Resume of Leonardo Maldonado, a senior full-stack engineer with 8+ years of remote experience, mostly in TypeScript. Creator of 33 JavaScript Concepts."
  canonical={`${SITE_URL}/resume`}
>
  <style is:global>
    .resume-head {
      display: flex;
      gap: 16px;
      align-items: baseline;
      justify-content: space-between;
    }

    .resume ul.bullets {
      display: grid;
      gap: 6px;
      padding-left: 1.1em;
      margin: 8px 0 0;
      color: var(--mute);
      list-style: disc;
    }

    .resume .bullets li::marker {
      color: var(--underline);
    }

    .skills {
      display: grid;
      gap: 8px;
      margin: 0;
    }

    .skills div {
      display: flex;
      gap: 16px;
    }

    .skills dt {
      flex: 0 0 9rem;
    }

    .skills dd {
      margin: 0;
      color: var(--mute);
    }

    @media (max-width: 420px) {
      .skills div {
        flex-direction: column;
        gap: 0;
      }

      .skills dt {
        flex-basis: auto;
      }
    }

    @media print {
      :root {
        --bg: #fff;
        --fg: #111;
        --mute: #444;
        --underline: #999;
      }

      .site-header,
      .site-footer,
      .no-print {
        display: none !important;
      }

      .page {
        max-width: none;
        padding: 0;
      }

      .content {
        margin-top: 0;
      }

      * + .section {
        margin-top: 28px;
      }

      .resume-section > * {
        break-inside: avoid;
      }

      a {
        text-decoration: none !important;
      }
    }
  </style>

  <div class="resume">
    <div class="resume-head">
      <h1 class="page-title">Resume</h1>
      <button class="button-link mute no-print" onclick="window.print()" type="button">Save as PDF</button>
    </div>

    <div class="stack text" style="margin-top: 16px;">
      <p class="mute">Senior full-stack engineer · Valencia, Spain (CET)<br /> <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href="tel:+34674271313">+34 674 27 13 13</a><br /> <a href={SITE_URL}>leonardomso.com</a> · <a href="https://github.com/leonardomso">github.com/leonardomso</a> · <a href="https://www.linkedin.com/in/leonardomso/">linkedin.com/in/leonardomso</a></p>
      <p>Senior full-stack engineer with 8+ years of experience, all of it remote, mostly in TypeScript, front and back. For four and a half years I was the only frontend engineer on Spaceship’s domain search at Namecheap, which sold more than 3 million domains. I’m building SetLuca, a DM sales platform for creators and coaches, and Strait, an open-source job and workflow engine on Postgres. I created 33 JavaScript Concepts (66K GitHub stars) and I’ve contributed to Better Auth, Node.js and TanStack. Open to senior full-stack and freelance roles, remote or partly on-site in Europe.</p>
    </div>

    <section class="section resume-section" aria-labelledby="h-experience">
      <h2 id="h-experience">Experience</h2>
      <ul class="entries">
        {experiences.map((exp) => (
          <li>
            <div class="entry-head">
              <a href={exp.companyUrl}>{exp.company}</a>
              <span class="entry-meta">{exp.period}</span>
            </div>
            <p class="mute">{exp.role}</p>
            <ul class="bullets">
              {exp.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section class="section resume-section" aria-labelledby="h-projects">
      <h2 id="h-projects">Projects</h2>
      <ul class="entries">
        {projects.map((project) => (
          <li>
            <div class="entry-head">
              <a href={project.url}>{project.name}</a>
              <span class="entry-meta">{project.meta}</span>
            </div>
            <p class="entry-body">{project.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section resume-section" aria-labelledby="h-skills">
      <h2 id="h-skills">Skills</h2>
      <dl class="skills">
        {skills.map((group) => (
          <div>
            <dt>{group.category}</dt>
            <dd>{group.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section resume-section" aria-labelledby="h-education">
      <h2 id="h-education">Education</h2>
      <ul class="entries">
        {education.map((edu) => (
          <li>
            <div class="entry-head">
              <span>{edu.school}</span>
              <span class="entry-meta">{edu.period}</span>
            </div>
            <p class="entry-body">{edu.degree}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section resume-section" aria-labelledby="h-recognition">
      <h2 id="h-recognition">Recognition</h2>
      <ul class="entries">
        <li>
          <p>GitHub top open-source project of 2018</p>
          <p class="entry-body">33 JavaScript Concepts, 66K stars and 40+ translations.</p>
        </li>
        <li>
          <p>Open-source contributor</p>
          <p class="entry-body">Code and documentation for Better Auth, Node.js and TanStack.</p>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
