{
  "name": "leonardomso-website",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro preview",
    "lint": "biome lint ./src",
    "basehub": "basehub",
    "biome:lint": "biome lint ./src",
    "biome:format": "biome format --write ./src",
    "biome:write": "biome check --write ./src",
    "biome:fix:unsafe": "biome check --fix --unsafe ./src",
    "typecheck": "astro check",
    "clean": "git clean -xdf dist .astro node_modules",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "run-all": "bun run biome:fix:unsafe && bun run biome:format && bun run biome:write && bun run biome:lint && bun run typecheck"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@dualmark/astro": "^0.11.0",
    "@dualmark/cloudflare": "^0.11.0",
    "@dualmark/converters": "^0.11.0",
    "@dualmark/core": "^0.11.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "basehub": "^9.6.0",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6",
    "ultracite": "^8.3.1",
    "wrangler": "^4.168.0"
  }
}
